<?php

declare(strict_types=1);

session_start();

$mensaje = '';
$error = '';

/*
|--------------------------------------------------------------------------
| CONEXIÓN A POSTGRESQL
|--------------------------------------------------------------------------
*/

$databaseUrl = getenv('DATABASE_URL');

if (!$databaseUrl) {
    die('DATABASE_URL no está configurada.');
}

try {

    $db = parse_url($databaseUrl);

    if (
        $db === false ||
        empty($db['host']) ||
        empty($db['path']) ||
        !isset($db['user']) ||
        !isset($db['pass'])
    ) {
        throw new RuntimeException('DATABASE_URL inválida.');
    }

    $host = $db['host'];
    $port = $db['port'] ?? 5432;
    $dbname = ltrim($db['path'], '/');
    $dbUser = urldecode((string)$db['user']);
    $dbPass = urldecode((string)$db['pass']);

    $dsn = sprintf(
        'pgsql:host=%s;port=%s;dbname=%s',
        $host,
        $port,
        $dbname
    );

    $pdo = new PDO(
        $dsn,
        $dbUser,
        $dbPass,
        [
            PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
            PDO::ATTR_EMULATE_PREPARES => false,
        ]
    );

} catch (Throwable $e) {

    error_log('Error conexión: ' . $e->getMessage());
    die('No se pudo conectar con la base de datos.');
}

/*
|--------------------------------------------------------------------------
| CREAR DISTRIBUIDOR DE PRUEBA
|--------------------------------------------------------------------------
*/

if ($_SERVER['REQUEST_METHOD'] === 'POST') {

    $password = (string)($_POST['password'] ?? '');

    if (strlen($password) < 6) {

        $error = 'La contraseña debe tener mínimo 6 caracteres.';

    } else {

        try {

            /*
            |--------------------------------------------------------------------------
            | VERIFICAR SI YA EXISTE
            |--------------------------------------------------------------------------
            */

            $correoPrueba = 'prueba@profirmaec.com';
            $documentoPrueba = '0100000001';

            $stmt = $pdo->prepare(
                'SELECT id
                 FROM distribuidores
                 WHERE LOWER(correo) = LOWER(:correo)
                    OR numero_documento = :documento
                 LIMIT 1'
            );

            $stmt->execute([
                ':correo' => $correoPrueba,
                ':documento' => $documentoPrueba
            ]);

            if ($stmt->fetch()) {

                $error = 'El distribuidor de prueba ya existe.';

            } else {

                /*
                |--------------------------------------------------------------------------
                | GENERAR CONTRASEÑA SEGURA
                |--------------------------------------------------------------------------
                */

                $passwordHash = password_hash(
                    $password,
                    PASSWORD_DEFAULT
                );

                /*
                |--------------------------------------------------------------------------
                | INSERTAR DISTRIBUIDOR
                |--------------------------------------------------------------------------
                */

                $sql = '
                    INSERT INTO distribuidores (
                        nombres,
                        apellidos,
                        tipo_documento,
                        numero_documento,
                        empresa,
                        "RUC",
                        telefono,
                        "WhatsApp",
                        correo,
                        password_hash,
                        estado,
                        tipo_membresia,
                        fecha_inicio_membresia,
                        fecha_vencimiento_membresia,
                        saldo
                    )
                    VALUES (
                        :nombres,
                        :apellidos,
                        :tipo_documento,
                        :numero_documento,
                        :empresa,
                        :ruc,
                        :telefono,
                        :whatsapp,
                        :correo,
                        :password_hash,
                        :estado,
                        :tipo_membresia,
                        CURRENT_TIMESTAMP,
                        CURRENT_TIMESTAMP + INTERVAL \'30 days\',
                        :saldo
                    )
                ';

                $stmt = $pdo->prepare($sql);

                $stmt->execute([
                    ':nombres' => 'Distribuidor',
                    ':apellidos' => 'Prueba',
                    ':tipo_documento' => 'CEDULA',
                    ':numero_documento' => $documentoPrueba,
                    ':empresa' => 'PRO-FIRMA PRUEBAS',
                    ':ruc' => '0100000001001',
                    ':telefono' => '0990000000',
                    ':whatsapp' => '0990000000',
                    ':correo' => $correoPrueba,
                    ':password_hash' => $passwordHash,
                    ':estado' => 'ACTIVO',
                    ':tipo_membresia' => 'PRUEBA',
                    ':saldo' => 100.00
                ]);

                $mensaje = 'Distribuidor de prueba creado correctamente.';
            }

        } catch (Throwable $e) {

            error_log(
                'Error creando distribuidor: ' .
                $e->getMessage()
            );

            $error = 'No se pudo crear el distribuidor. Revisa los registros del servidor.';
        }
    }
}

